// Convoy ledger schema.
//
// Scaffold only. The five frozen models — runs, items, attempts, events,
// manifests — are implemented in CVY-005 exactly as specified in
// docs/ARCHITECTURE.md §5(g): bytea -> Bytes, numeric(20,6) -> Decimal,
// jsonb -> Json, events.id as bigserial (the SSE event id).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
